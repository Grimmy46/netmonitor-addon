# ─── Copy to .env and fill in. NEVER commit .env. ───

# Postgres
POSTGRES_USER=netmonitor
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=netmonitor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cloud backend
# DATABASE_URL is assembled from the POSTGRES_* vars by default; override if needed.
SECRET_KEY=change-me-generate-a-long-random-string
# Fernet key used to encrypt stored UniFi API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key
CORS_ORIGINS=http://localhost:5173

# Web (build-time)
VITE_API_BASE_URL=http://localhost:8000
