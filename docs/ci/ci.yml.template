name: CI

on:
  push:
    branches: [main, v2]
  pull_request:

jobs:
  cloud:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install cloud
        working-directory: cloud
        run: |
          python -m pip install --upgrade pip
          pip install ".[dev]"
      - name: Lint cloud
        working-directory: cloud
        run: ruff check .
      - name: Compile-check cloud
        working-directory: cloud
        run: python -m compileall app alembic

  agent:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install agent
        working-directory: agent
        run: |
          python -m pip install --upgrade pip
          pip install ".[dev]"
      - name: Lint agent
        working-directory: agent
        run: ruff check .

  web:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install web
        working-directory: web
        run: npm install
      - name: Type-check + build
        working-directory: web
        run: npm run build
